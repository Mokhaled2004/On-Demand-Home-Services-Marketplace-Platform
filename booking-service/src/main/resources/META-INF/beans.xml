<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/beans_4_1.xsd"
       bean-discovery-mode="all">
    <!--
        bean-discovery-mode="all" tells CDI to scan ALL classes in the archive.
        This ensures @ApplicationScoped beans (UserServiceClient, CatalogServiceClient)
        are discovered and injectable alongside the @Stateless and @Singleton EJBs.
    -->
</beans>
